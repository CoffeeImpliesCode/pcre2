// SPDX-License-Identifier: BSD-3-Clause WITH PCRE2-exception
// Copyright (c) 2026 the contributors to this fork.
.{
    // Import this package's facade with `dep.module("pcre2")`.
    .name = .pcre2,
    // Pinned upstream release; `build.zig` checks this version.
    .version = "10.49.0",
    // Fork package identity generated for this name and version.
    .fingerprint = 0x914b3d639d1db54d, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    // JIT is disabled because SLJIT is not shipped; the consumer has a separate manifest.
    .dependencies = .{},
    // `.paths` defines the files fetched with this package.
    .paths = .{
        // Fork build graph.
        "build.zig",
        "build.zig.zon",
        // Cross-test settings shipped with the package; `build.zig` does not read them.
        "cross-test.profile.sh",
        // Aggregate translation header using the generated core header.
        "translate.h",
        // Zig facade.
        "zig",
        // Facade tests and smoke example.
        "tests.zig",
        "smoke.zig",
        // Test inputs and fixtures used by the fork and upstream suite.
        "testdata",
        // Consumer package with a relative dependency on this package.
        "consumer/build.zig",
        "consumer/build.zig.zon",
        "consumer/src/main.zig",

        // Upstream C sources and templates.
        // Includes the core, export maps, and distributed character tables.
        "src",
        // Runtime-loader sources required by `-Druntime`.
        "runtime",
        "doc",
        // Upstream pkg-config templates embedded by the build.
        "libpcre2-8.pc.in",
        "libpcre2-16.pc.in",
        "libpcre2-32.pc.in",
        "libpcre2-posix.pc.in",
        // Upstream `pcre2-config` template.
        "pcre2-config.in",

        // Upstream tests.
        // `RunTest` and its test data are used by `zig build upstream-test`.
        "RunTest",

        // Upstream licence, authorship, security records, and documentation.
        "LICENCE.md",
        "COPYING",
        "AUTHORS.md",
        "SECURITY.md",
        "ChangeLog",
        "NEWS",
        "README",
        "SUPPORT-LIFECYCLE.md",
        "HACKING",
        "INSTALL",

        // Fork provenance and licence records installed beside upstream's.
        "README.md",
        "README.zig.md",
        "README.upstream.md",
        "UPSTREAM.md",
        "UPSTREAM.sha256",
        "NOTICE.md",
        "FORK-LICENSE.md",
        "FORK-NOTES.md",
        "CHANGELOG.md",

        // Nix and devenv packaging.
        // Shipped for consumers; these files add no build sources or compile flags.
        // `flake.lock` pins the Nix inputs.
        "package.nix",
        "flake.nix",
        "flake.lock",
        "devenv.nix",
        "devenv.yaml",
        ".envrc",
    },
}
