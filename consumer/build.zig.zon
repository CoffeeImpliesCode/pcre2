.{
    .name = .pcre2_consumer,
    .version = "0.1.0",
    // Separate from the library's fingerprint because this is a different
    // package with a different name. It exists to prove that the library's
    // published module can be consumed by a package that did not write it.
    .fingerprint = 0xb58b6def195d243e, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // A relative path, not a registry or archive URL. The consumer is the
        // proof that `dep.module("pcre2")` works from outside the package that
        // defines it; resolving that through the network would make the proof
        // depend on a published state of the world instead of on this tree.
        .pcre2 = .{ .path = ".." },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
